rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Test connection endpoint
    match /test/{docId} {
      allow read, write: if true;
    }

    // UNIFIED COLLECTIONS
    match /units/{unitId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /patients/{patientId} {
      allow read, write: if true;
    }

    match /beds/{bedId} {
      allow read, write: if true;
    }

    match /transfers/{transferId} {
      allow read, write: if true;
    }

    match /medical_records/{recordId} {
      allow read, write: if true;
    }

    match /handovers/{handoverId} {
      allow read, write: if true;
    }

    match /operations/{operationId} {
      allow read, write: if true;
    }

    // LEGACY COMPATIBILITY COLLECTIONS
    match /admins/{userId} {
      allow read, write: if true;
    }

    match /clinicalNotes/{noteId} {
      allow read, write: if true;
    }

    match /addendums/{addendumId} {
      allow read, write: if true;
    }

    match /sbarHandovers/{sbarId} {
      allow read, write: if true;
    }

    match /dispositionRecords/{dispoId} {
      allow read, write: if true;
    }

    match /vitals/{vitalId} {
      allow read, write: if true;
    }

    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    match /ventilators/{id} {
      allow read, write: if true;
    }

    match /infusionPumps/{id} {
      allow read, write: if true;
    }

    match /fluidBalances/{id} {
      allow read, write: if true;
    }

    match /statLabs/{id} {
      allow read, write: if true;
    }

    match /transfusions/{id} {
      allow read, write: if true;
    }

    match /staff/{id} {
      allow read, write: if true;
    }

    match /fluidBalances24H/{id} {
      allow read, write: if true;
    }

    // Fallback catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
