rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isExistingUser() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isNotDisabledUser() {
      return isAuthenticated() && (
        !isExistingUser() || (
          getUserData().active != false &&
          getUserData().isActive != false
        )
      );
    }

    function isActiveUser() {
      return isAuthenticated() && isExistingUser() && (
        getUserData().active == true || 
        getUserData().isActive == true
      );
    }

    function isAdmin() {
      return isActiveUser() && (
        getUserData().role == 'ADMIN' || 
        getUserData().isSuperAdmin == true
      );
    }

    function hasPerm(perm) {
      return isActiveUser() && (
        isAdmin() || (
          'permissions' in getUserData() &&
          perm in getUserData().permissions &&
          getUserData().permissions[perm] == true
        )
      );
    }

    function isValidMedicalRecordCreate() {
      return isActiveUser() && (
        isAdmin() || 
        request.resource.data.createdByUid == request.auth.uid ||
        !("createdByUid" in request.resource.data)
      );
    }

    function isRecordOwner() {
      return (
        ("createdByUid" in resource.data && resource.data.createdByUid == request.auth.uid) ||
        ("doctorId" in resource.data && resource.data.doctorId == request.auth.uid) ||
        ("authorId" in resource.data && resource.data.authorId == request.auth.uid) ||
        ("authorStaffId" in resource.data && resource.data.authorStaffId == request.auth.uid) ||
        ("recordedByStaffId" in resource.data && resource.data.recordedByStaffId == request.auth.uid) ||
        ("userId" in resource.data && resource.data.userId == request.auth.uid)
      );
    }

    function isValidMedicalRecordUpdate() {
      return isActiveUser() && (
        isAdmin() || (
          isRecordOwner() &&
          (!("createdByUid" in resource.data) || request.resource.data.createdByUid == resource.data.createdByUid) &&
          (!("doctorId" in resource.data) || request.resource.data.doctorId == resource.data.doctorId) &&
          (!("authorId" in resource.data) || request.resource.data.authorId == resource.data.authorId) &&
          (!("authorStaffId" in resource.data) || request.resource.data.authorStaffId == resource.data.authorStaffId) &&
          (!("recordedByStaffId" in resource.data) || request.resource.data.recordedByStaffId == resource.data.recordedByStaffId) &&
          (!("userId" in resource.data) || request.resource.data.userId == resource.data.userId) &&
          (!("createdAt" in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        )
      );
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        request.auth.uid == userId ||
        hasPerm('users.view')
      );

      allow create: if isAdmin() || (
        hasPerm('users.create') &&
        request.resource.data.role != 'ADMIN' &&
        request.resource.data.isSuperAdmin != true
      );

      allow update: if isAdmin() || (
        hasPerm('users.update') &&
        resource.data.role != 'ADMIN' &&
        resource.data.isSuperAdmin != true &&
        request.resource.data.role != 'ADMIN' &&
        request.resource.data.isSuperAdmin != true
      ) || (
        hasPerm('users.disable') &&
        resource.data.role != 'ADMIN' &&
        resource.data.isSuperAdmin != true &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.isSuperAdmin == resource.data.isSuperAdmin &&
        request.resource.data.permissions == resource.data.permissions
      ) || (
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'nameAr',
          'nameEn',
          'phone',
          'specialty',
          'department',
          'licenseNumber',
          'updatedAt'
        ])
      );

      allow delete: if isAdmin() || (
        hasPerm('users.delete') &&
        resource.data.role != 'ADMIN' &&
        resource.data.isSuperAdmin != true
      );
    }

    // Patients Collection
    match /patients/{patientId} {
      allow read: if hasPerm('patients.view') || hasPerm('beds.view');
      allow create: if hasPerm('patients.create');
      allow update: if hasPerm('patients.update') || hasPerm('patients.create') || hasPerm('transfer.create') || hasPerm('bedSwap.create') || hasPerm('discharge.create');
      allow delete: if isAdmin();
    }

    // Archived Patients (Client Read-Only for non-admin)
    match /archivedPatients/{patientId} {
      allow read: if hasPerm('archive.view');
      allow write: if isAdmin();
    }

    // Beds Collection
    match /beds/{bedId} {
      allow read: if hasPerm('beds.view') || hasPerm('patients.view');
      allow create: if isAdmin();
      allow update: if hasPerm('patients.create') || hasPerm('patients.update') || hasPerm('transfer.create') || hasPerm('bedSwap.create') || hasPerm('discharge.create');
      allow delete: if isAdmin();
    }

    // Admission episodes
    match /episodes/{episodeId} {
      allow read: if hasPerm('patients.view');
      allow create: if hasPerm('patients.create');
      allow update: if hasPerm('patients.update') || hasPerm('discharge.create');
      allow delete: if isAdmin();
    }

    // Transfers & Operations
    match /transfers/{transferId} {
      allow read: if hasPerm('beds.view') || hasPerm('patients.view');
      allow create, update: if hasPerm('transfer.create') || hasPerm('bedSwap.create');
      allow delete: if isAdmin();
    }

    match /operations/{operationId} {
      allow read: if hasPerm('beds.view') || hasPerm('patients.view');
      allow create, update: if hasPerm('transfer.create') || hasPerm('bedSwap.create') || hasPerm('discharge.create') || hasPerm('patients.create');
      allow delete: if isAdmin();
    }

    match /units/{unitId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Clinical Notes
    match /clinicalNotes/{noteId} {
      allow read: if hasPerm('clinicalNotes.view') || hasPerm('patients.view');
      allow create: if hasPerm('clinicalNotes.create');
      allow update: if hasPerm('clinicalNotes.update') && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /addendums/{addendumId} {
      allow read: if hasPerm('clinicalNotes.view') || hasPerm('patients.view');
      allow create: if hasPerm('clinicalNotes.update') || hasPerm('clinicalNotes.create');
      allow update: if false; // Immutable addendums
      allow delete: if isAdmin();
    }

    // SBAR Handovers & Shift Transitions
    match /sbarHandovers/{sbarId} {
      allow read: if hasPerm('sbar.view') || hasPerm('patients.view');
      allow create: if hasPerm('sbar.create');
      allow update: if (hasPerm('sbar.update') || hasPerm('sbar.create')) && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /handovers/{handoverId} {
      allow read: if hasPerm('sbar.view') || hasPerm('patients.view');
      allow create: if hasPerm('sbar.create');
      allow update: if (hasPerm('sbar.update') || hasPerm('sbar.create')) && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    // Telemetry Vitals, Ventilator, Infusions & Labs
    match /vitals/{vitalId} {
      allow read: if hasPerm('vitals.view') || hasPerm('beds.view') || hasPerm('patients.view');
      allow create: if hasPerm('vitals.create');
      allow update: if hasPerm('vitals.update') && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /ventilators/{id} {
      allow read: if hasPerm('vitals.view') || hasPerm('beds.view') || hasPerm('patients.view');
      allow create: if hasPerm('vitals.create') || hasPerm('patients.update');
      allow update: if (hasPerm('vitals.update') || hasPerm('patients.update')) && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /infusionPumps/{id} {
      allow read: if hasPerm('vitals.view') || hasPerm('beds.view') || hasPerm('patients.view');
      allow create: if hasPerm('vitals.create') || hasPerm('patients.update');
      allow update: if (hasPerm('vitals.update') || hasPerm('patients.update')) && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /infusion_pumps/{id} {
      allow read: if hasPerm('vitals.view') || hasPerm('beds.view') || hasPerm('patients.view');
      allow create: if hasPerm('vitals.create') || hasPerm('patients.update');
      allow update: if (hasPerm('vitals.update') || hasPerm('patients.update')) && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /patientAntibiotics/{id} {
      allow read: if hasPerm('vitals.view') || hasPerm('beds.view') || hasPerm('patients.view');
      allow create: if hasPerm('vitals.create') || hasPerm('patients.update');
      allow update: if (hasPerm('vitals.update') || hasPerm('patients.update')) && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /fluidBalances/{id} {
      allow read: if hasPerm('vitals.view') || hasPerm('beds.view') || hasPerm('patients.view');
      allow create: if hasPerm('vitals.create') || hasPerm('patients.update');
      allow update: if (hasPerm('vitals.update') || hasPerm('patients.update')) && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /fluidBalances24H/{id} {
      allow read: if hasPerm('vitals.view') || hasPerm('beds.view') || hasPerm('patients.view');
      allow create: if hasPerm('vitals.create') || hasPerm('patients.update');
      allow update: if (hasPerm('vitals.update') || hasPerm('patients.update')) && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /statLabs/{id} {
      allow read: if hasPerm('labs.view') || hasPerm('patients.view');
      allow create: if hasPerm('labs.create');
      allow update: if hasPerm('labs.update') && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /investigations/{id} {
      allow read: if hasPerm('investigations.view') || hasPerm('patients.view');
      allow create: if hasPerm('investigations.create');
      allow update: if hasPerm('investigations.update') && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /transfusions/{id} {
      allow read: if hasPerm('patients.view');
      allow create: if hasPerm('patients.update') || hasPerm('clinicalNotes.create');
      allow update: if (hasPerm('patients.update') || hasPerm('clinicalNotes.update')) && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /medical_records/{recordId} {
      allow read: if hasPerm('patients.view');
      allow create: if hasPerm('patients.update') || hasPerm('clinicalNotes.create');
      allow update: if (hasPerm('patients.update') || hasPerm('clinicalNotes.update')) && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /dispositionRecords/{dispoId} {
      allow read: if hasPerm('archive.view') || hasPerm('patients.view');
      allow create, update: if hasPerm('discharge.create') && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    // Dynamic Sections & Cards Management
    match /sections/{sectionId} {
      allow read: if isActiveUser();
      allow write: if isAdmin() || hasPerm('sections.manage');
    }

    match /cards/{cardId} {
      allow read: if isActiveUser();
      allow write: if isAdmin() || hasPerm('cards.manage');
    }

    // Hospital Chat (1-to-1 & Department Chat)
    match /chats/{chatId} {
      allow read: if isNotDisabledUser() && hasPerm('chat.view') && (
        isAdmin() ||
        resource.data.type == 'department' ||
        (resource.data.participantUids != null && request.auth.uid in resource.data.participantUids) ||
        (resource.data.participants != null && request.auth.uid in resource.data.participants)
      );
      allow create: if isNotDisabledUser() && hasPerm('chat.create');
      allow update: if isNotDisabledUser() && hasPerm('chat.create') && (
        isAdmin() ||
        resource.data.type == 'department' ||
        (resource.data.participantUids != null && request.auth.uid in resource.data.participantUids) ||
        (resource.data.participants != null && request.auth.uid in resource.data.participants)
      );
      allow delete: if isAdmin() || (
        isNotDisabledUser() && hasPerm('chat.delete') &&
        resource.data.type != 'department' && (
          resource.data.createdByUid == request.auth.uid ||
          (resource.data.participantUids != null && request.auth.uid in resource.data.participantUids) ||
          (resource.data.participants != null && request.auth.uid in resource.data.participants)
        )
      );
    }

    match /chatMessages/{messageId} {
      allow read: if isNotDisabledUser() && hasPerm('chat.view');
      allow create: if isNotDisabledUser() && hasPerm('chat.create') && (
        request.resource.data.senderUid == request.auth.uid ||
        (isExistingUser() && request.resource.data.senderUid == getUserData().uid)
      );
      allow update: if isNotDisabledUser() && hasPerm('chat.create') && (
        request.auth.uid == resource.data.senderUid ||
        (isExistingUser() && resource.data.senderUid == getUserData().uid) ||
        isAdmin()
      );
      allow delete: if isAdmin() || (
        isNotDisabledUser() && hasPerm('chat.delete') && (
          resource.data.senderUid == request.auth.uid ||
          (isExistingUser() && resource.data.senderUid == getUserData().uid)
        )
      );
    }

    // Audit Logs (Immutable ledger)
    match /auditLogs/{logId} {
      allow read: if isAdmin() || hasPerm('audit.view');
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Clinical & Operational Notifications
    match /notifications/{notifId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isActiveUser();
    }

    // System Settings
    match /system_settings/{settingId} {
      allow read: if isActiveUser() || hasPerm('settings.view');
      allow write: if isAdmin() || hasPerm('settings.update');
    }

    match /admins/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
