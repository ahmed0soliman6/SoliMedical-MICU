rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Test connection endpoint
    match /test/{docId} {
      allow read, write: if true;
    }

    // USERS COLLECTION - Source of truth for staff profiles, roles & credentials
    match /users/{userId} {
      allow read, write: if true;
    }

    // ADMINS COLLECTION
    match /admins/{userId} {
      allow read, write: if true;
    }

    // BEDS & PATIENT DOSSIERS
    match /beds/{bedId} {
      allow read, write: if true;
    }

    match /patients/{patientId} {
      allow read, write: if true;
    }

    // CLINICAL NOTES & ADDENDUMS
    match /clinicalNotes/{noteId} {
      allow read, write: if true;
    }

    match /addendums/{addendumId} {
      allow read, write: if true;
    }

    // SBAR HANDOVERS & DISPOSITION RECORDS
    match /sbarHandovers/{sbarId} {
      allow read, write: if true;
    }

    match /dispositionRecords/{dispoId} {
      allow read, write: if true;
    }

    // TELEMETRY VITALS & AUDIT LOGS
    match /vitals/{vitalId} {
      allow read, write: if true;
    }

    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Fallback catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
