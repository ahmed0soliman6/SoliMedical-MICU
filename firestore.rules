rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isExistingUser() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isNotDisabledUser() {
      return isAuthenticated() && (
        !isExistingUser() || (
          getUserData().active != false &&
          getUserData().isActive != false
        )
      );
    }

    function isActiveUser() {
      return isAuthenticated() && isExistingUser() && (
        getUserData().active == true || 
        getUserData().isActive == true
      );
    }

    function isAdmin() {
      return isActiveUser() && (
        getUserData().role == 'ADMIN' || 
        getUserData().isSuperAdmin == true
      );
    }

    function isDoctor() {
      return isActiveUser() && (
        getUserData().role == 'DOCTOR' || 
        getUserData().role == 'CONSULTANT' || 
        getUserData().role == 'SPECIALIST' || 
        getUserData().role == 'RESIDENT' || 
        isAdmin()
      );
    }

    function isNurse() {
      return isActiveUser() && (
        getUserData().role == 'NURSE' || 
        getUserData().role == 'BEDSIDE_RN' || 
        getUserData().role == 'LEAD_RN' || 
        isAdmin()
      );
    }

    function isClinician() {
      return isActiveUser();
    }

    function isValidMedicalRecordCreate() {
      return isActiveUser() && (
        isAdmin() || 
        request.resource.data.createdByUid == request.auth.uid ||
        !("createdByUid" in request.resource.data)
      );
    }

    function isRecordOwner() {
      return (
        ("createdByUid" in resource.data && resource.data.createdByUid == request.auth.uid) ||
        ("doctorId" in resource.data && resource.data.doctorId == request.auth.uid) ||
        ("authorId" in resource.data && resource.data.authorId == request.auth.uid) ||
        ("authorStaffId" in resource.data && resource.data.authorStaffId == request.auth.uid) ||
        ("recordedByStaffId" in resource.data && resource.data.recordedByStaffId == request.auth.uid) ||
        ("userId" in resource.data && resource.data.userId == request.auth.uid)
      );
    }

    function isValidMedicalRecordUpdate() {
      return isActiveUser() && (
        isAdmin() || (
          isRecordOwner() &&
          (!("createdByUid" in resource.data) || request.resource.data.createdByUid == resource.data.createdByUid) &&
          (!("doctorId" in resource.data) || request.resource.data.doctorId == resource.data.doctorId) &&
          (!("authorId" in resource.data) || request.resource.data.authorId == resource.data.authorId) &&
          (!("authorStaffId" in resource.data) || request.resource.data.authorStaffId == resource.data.authorStaffId) &&
          (!("recordedByStaffId" in resource.data) || request.resource.data.recordedByStaffId == resource.data.recordedByStaffId) &&
          (!("userId" in resource.data) || request.resource.data.userId == resource.data.userId) &&
          (!("createdAt" in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        )
      );
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Users Collection (Disabled users cannot read users)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
      allow update: if isAuthenticated() && (
        isAdmin() || (
          request.auth.uid == userId
        )
      );
      allow delete: if isAdmin();
    }

    // Patients Collection
    match /patients/{patientId} {
      allow read: if isClinician();
      allow create, update: if isClinician();
      allow delete: if isAdmin();
    }

    // Beds Collection (Clinicians can admit, transfer, vacate beds)
    match /beds/{bedId} {
      allow read: if isClinician();
      allow create, update: if isClinician();
      allow delete: if isAdmin();
    }

    // Admission episodes are written in the same transaction as patients and beds.
    // Omitting this match rejects the entire transaction with Permission Denied.
    match /episodes/{episodeId} {
      allow read: if isClinician();
      allow create, update: if isClinician();
      allow delete: if isAdmin();
    }

    // Transfers & Operations
    match /transfers/{transferId} {
      allow read: if isClinician();
      allow create, update: if isClinician();
      allow delete: if isAdmin();
    }

    match /operations/{operationId} {
      allow read: if isClinician();
      allow create, update: if isClinician();
      allow delete: if isAdmin();
    }

    match /units/{unitId} {
      allow read: if isClinician();
      allow write: if isAdmin();
    }

    // Clinical Notes
    match /clinicalNotes/{noteId} {
      allow read: if isClinician();
      allow create: if isClinician();
      allow update: if isClinician() && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /addendums/{addendumId} {
      allow read: if isClinician();
      allow create: if isClinician();
      allow update: if isClinician() && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    // SBAR Handovers & Shift Transitions
    match /sbarHandovers/{sbarId} {
      allow read: if isClinician();
      allow create: if isClinician();
      allow update: if isClinician() && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /handovers/{handoverId} {
      allow read: if isClinician();
      allow create: if isClinician();
      allow update: if isClinician() && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    // Telemetry Vitals, Ventilator, Infusions & Labs
    match /vitals/{vitalId} {
      allow read: if isClinician();
      allow create: if isClinician();
      allow update: if isClinician() && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /ventilators/{id} {
      allow read: if isClinician();
      allow create: if isClinician();
      allow update: if isClinician() && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /infusionPumps/{id} {
      allow read: if isClinician();
      allow create: if isClinician();
      allow update: if isClinician() && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /infusion_pumps/{id} {
      allow read: if isClinician();
      allow create: if isClinician();
      allow update: if isClinician() && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /patientAntibiotics/{id} {
      allow read: if isClinician();
      allow create: if isClinician();
      allow update: if isClinician() && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /fluidBalances/{id} {
      allow read: if isClinician();
      allow create, update: if isClinician();
      allow delete: if isAdmin();
    }

    match /fluidBalances24H/{id} {
      allow read: if isClinician();
      allow create, update: if isClinician();
      allow delete: if isAdmin();
    }

    match /statLabs/{id} {
      allow read: if isClinician();
      allow create: if isClinician();
      allow update: if isClinician() && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /investigations/{id} {
      allow read: if isClinician();
      allow create: if isClinician();
      allow update: if isClinician() && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /transfusions/{id} {
      allow read: if isClinician();
      allow create, update: if isClinician();
      allow delete: if isAdmin();
    }

    match /medical_records/{recordId} {
      allow read: if isClinician();
      allow create: if isClinician();
      allow update: if isClinician() && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    match /dispositionRecords/{dispoId} {
      allow read: if isClinician();
      allow create, update: if isClinician() && isValidMedicalRecordUpdate();
      allow delete: if isAdmin();
    }

    // Dynamic Sections & Cards Management
    match /sections/{sectionId} {
      allow read: if isClinician();
      allow write: if isAdmin();
    }

    match /cards/{cardId} {
      allow read: if isClinician();
      allow write: if isAdmin();
    }

    // Hospital Chat (1-to-1 & Department Chat)
    match /chats/{chatId} {
      allow read: if isActiveUser() && (
        isAdmin() ||
        resource.data.type == 'department' ||
        (resource.data.participantUids != null && request.auth.uid in resource.data.participantUids) ||
        (resource.data.participants != null && request.auth.uid in resource.data.participants)
      );
      allow create: if isActiveUser();
      allow update: if isActiveUser() && (
        isAdmin() ||
        resource.data.type == 'department' ||
        (resource.data.participantUids != null && request.auth.uid in resource.data.participantUids) ||
        (resource.data.participants != null && request.auth.uid in resource.data.participants)
      );
      allow delete: if isAdmin();
    }

    match /chatMessages/{messageId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && request.resource.data.senderUid == request.auth.uid;
      allow update: if isActiveUser() && request.auth.uid == resource.data.senderUid;
      allow delete: if isAdmin();
    }

    // Audit Logs (Immutable ledger)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Clinical & Operational Notifications
    match /notifications/{notifId} {
      allow read: if isClinician();
      allow create, update: if isClinician();
      allow delete: if isClinician() || isAdmin();
    }

    // System Settings
    match /system_settings/{settingId} {
      allow read: if isClinician();
      allow write: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
