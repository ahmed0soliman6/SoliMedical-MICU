{
  "name": "react-example",
  "private": true,
  "version": "4.3.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-sw.cjs && tsx server.ts",
    "build": "node scripts/generate-sw.cjs && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "test": "tsx src/tests/permissions.test.ts",
    "test:rules": "tsx src/tests/firestore-rules.test.ts",
    "test:all": "tsx src/tests/permissions.test.ts && tsx src/tests/firestore-rules.test.ts",
    "lint": "tsc --noEmit",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@emotion/is-prop-valid": "^1.4.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "dexie": "^4.4.6",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "jwks-rsa": "^3.1.0",
    "jose": "^4.15.9"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "sharp": "^0.35.4"
  }
}
